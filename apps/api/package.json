{
  "name": "@rojer/mf-api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:build": "bun run ./script/db-build.ts",
    "db:undo": "bun run ./script/db-undo.ts",
    "db:add": "bun run ./script/db-add.ts",
    "build": "NODE_ENV=production bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts"
  },
  "devDependencies": {
    "@rojer/mf-common": "workspace:*",
    "@types/ali-oss": "^6.23.2",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/ms": "^2.1.0",
    "@types/speakeasy": "^2.0.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.2",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/static": "^1.4.7",
    "@napi-rs/canvas": "^0.1.88",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.66.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.21",
    "fast-safe-stringify": "^2.1.1",
    "ioredis": "5.9.1",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.17.22",
    "logform": "^2.7.0",
    "mime": "^4.1.0",
    "moment": "^2.29.1",
    "ms": "^2.1.3",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "qiniu": "^7.15.1",
    "reflect-metadata": "^0.2.2",
    "speakeasy": "^2.0.0",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.28",
    "typeorm-naming-strategy": "^2.0.16",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.5"
  }
}
